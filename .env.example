# Names only. Copy to .env and fill in locally. Never commit .env.

# Back-end (services/api)
OFFLINE=
DATA_DIR=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
LOG_LEVEL=

# Front-end (apps/web)
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_API_BASE=

# Front-end: load the static mocks for contract requests R1/R2 (illustrative fields). Dev only.
NEXT_PUBLIC_MOCK_EXTRAS=

# Optional recorded backup video URL or local public path.
NEXT_PUBLIC_BACKUP_VIDEO_URL=
