# Names only. Copy to .env and fill in locally. Never commit .env.

# Back-end (services/api)
OFFLINE=
DATA_DIR=
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
EARTHDATA_TOKEN=
# Optional live SEAS5 overlay for the monthly baseline outlook.
OPEN_METEO_SEASONAL=
LOG_LEVEL=
# Gus (farm chat) provider key. Read by services/api from the process env, then this file.
GROQ_API_KEY=
# Second provider for Gus (NVIDIA API catalog, build.nvidia.com), tried when Groq is missing or fails.
NVIDIA_API_KEY=
# Last fallback provider for Gus.
OPENROUTER_API_KEY=
# Allowed web origins, comma-separated (default http://localhost:3000), e.g. https://stardew-earth.vercel.app
CORS_ORIGINS=
# Optional regex for preview deploys, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Front-end (apps/web)
NEXT_PUBLIC_API_MODE=
NEXT_PUBLIC_API_BASE=

# Front-end: load the static mocks for contract requests R1/R2 (illustrative fields). Dev only.
NEXT_PUBLIC_MOCK_EXTRAS=

# Optional recorded backup video URL or local public path.
NEXT_PUBLIC_BACKUP_VIDEO_URL=
